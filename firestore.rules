rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Blog Posts
    match /blogPosts/{postId} {
      // Allow public read for individual posts and listing all posts
      allow get, list: if true;
      // Allow writes only for authenticated users (admins)
      allow write, update, delete: if request.auth != null;
    }

    // References
    match /references/{refId} {
      // Allow public read for individual references and listing all references
      allow get, list: if true;
      // Allow writes only for authenticated users (admins)
      allow write, update, delete: if request.auth != null;
    }

    // Contact Submissions
    match /contactSubmissions/{submissionId} {
      // Allow anyone to create (submit the form)
      allow create: if true;
      // Only allow authenticated users to read, update, or delete
      allow read, update, delete: if request.auth != null;
    }
  }
}
